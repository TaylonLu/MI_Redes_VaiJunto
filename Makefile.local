# Makefile.local — módulo do servidor SEM docker (Maven direto na máquina)
#
# Uso:   make -f Makefile.local <alvo> [REGIAO=kanto] [PORT=3001]
# Dica:  alias mk='make -f Makefile.local'   ->   mk run REGIAO=johto PORT=3002

MVN         ?= mvn
MODULE      ?= Server
REGIAO      ?= Unova
PORT		?= 2602
RUN_FLAGS   ?= -q
TESTE_FALHA_COMMIT ?= false

# O Main recebe a região e a porta via System Properties (-Dserver.regiao e -Dserver.port)
RUN := JAVA_TOOL_OPTIONS="-Dteste.falhar-primeiro-commit=$(TESTE_FALHA_COMMIT)" \
    $(MVN) $(RUN_FLAGS) -pl $(MODULE) exec:java \
    -Dserver.regiao=$(REGIAO) \
    -Dserver.port=$(PORT)

.DEFAULT_GOAL := help
.PHONY: help compile run run-only clean rebuild test kanto johto unova kalos

help:
	@echo "Servidor local (sem docker)"
	@echo ""
	@echo "  make -f Makefile.local compile                      compila o servidor sem rodar testes"
	@echo "  make -f Makefile.local run                          compila e inicia (Padrao: REGIAO=$(REGIAO), PORT=$(PORT))"
	@echo "  make -f Makefile.local run REGIAO=johto PORT=3002   compila e inicia regiao/porta especificas"
	@echo "  make -f Makefile.local run-only REGIAO=kanto        inicia sem recompilar"
	@echo "  make -f Makefile.local clean                        limpa os diretorios target"
	@echo "  make -f Makefile.local rebuild                      clean + compile"
	@echo "  make -f Makefile.local test                         roda os testes"
	@echo ""
	@echo "Atalhos rapidos para o consorcio:"
	@echo "  make -f Makefile.local unova                        Sobe Unova  (porta 2602)"
	@echo "  make -f Makefile.local kalos                        Sobe Kalos  (porta 2603)"
	@echo "  make -f Makefile.local johto                        Sobe Johto  (porta 2604)"
	@echo "  make -f Makefile.local kanto                        Sobe Kanto  (porta 2605)"
	@echo ""
	@echo "Variaveis atuais: REGIAO=$(REGIAO)  PORT=$(PORT)  MODULE=$(MODULE)  MVN=$(MVN)"

compile:
	$(MVN) -pl $(MODULE) -am install -DskipTests

run: compile
	$(RUN)

run-only:
	$(RUN)

# --- Atalhos para subir os nós da rede rapidamente em terminais separados ---
kanto:
	$(MAKE) -f Makefile.local run-only REGIAO=kanto PORT=2605

johto:
	$(MAKE) -f Makefile.local run-only REGIAO=johto PORT=2604

unova:
	$(MAKE) -f Makefile.local run-only REGIAO=unova PORT=2602

kalos:
	$(MAKE) -f Makefile.local run-only REGIAO=kalos PORT=2603

clean:
	$(MVN) -pl $(MODULE) -am clean

rebuild: clean compile

test:
	$(MVN) -pl $(MODULE) -am test